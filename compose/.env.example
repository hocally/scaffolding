# Runtime environment for /srv/compose/docker-compose.yml.
# Copy to /srv/compose/.env on the server. bootstrap.sh does this automatically.

COMPOSE_PROJECT_NAME=homeserver
TZ=America/Los_Angeles

# Informational values detected by bootstrap. These help commissioning notes and diagnostics.
SERVER_HOSTNAME=
HOST_LAN_IP=

# Numeric UID/GID for the non-root operator account that should own service files.
SERVICE_UID=1000
SERVICE_GID=1000

# Gitea is proxied beneath the Mainframe dashboard. The mDNS hostname must be
# unique on the LAN and match SERVER_HOSTNAME in bootstrap/env.
GITEA_DOMAIN=mainframe.local
GITEA_ROOT_URL=http://mainframe.local/gitea/
GITEA_SSH_DOMAIN=mainframe.local
GITEA_SSH_PORT=2222

# Sample local app LAN name. Keep aligned with compose/caddy/Caddyfile and local DNS.
SAMPLE_DOMAIN=campsites

# Retro Waveform is an opt-in control-plane container. Build its local image from the
# retro-waveform repository before enabling its Compose profile.
RETRO_WAVEFORM_DOMAIN=retro-waveform

# For first setup, leave registration enabled long enough to create the first admin.
# Afterward set this to true and restart Gitea.
GITEA_DISABLE_REGISTRATION=false
