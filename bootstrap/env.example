# Copy this file to bootstrap/env on the Ubuntu server before running bootstrap.sh.
# This file is shell-sourced by bootstrap.sh, so keep values simple.

# Non-root operator account that should own /srv files and be allowed to run Docker.
# Leave blank to use the sudo caller.
SERVER_USER=

# Leave blank to use SERVER_USER's primary group.
SERVER_GROUP=

# Leave blank to detect the short hostname set during Ubuntu installation.
SERVER_HOSTNAME=

# Set to 1 to install and enable Avahi so the server is reachable as
# <SERVER_HOSTNAME>.local on clients that support mDNS.
ENABLE_MDNS=0

# Leave blank to make Gitea advertise the detected LAN IP. Set to a DNS name
# such as gitea.home.arpa only if that name already resolves on your LAN.
GITEA_ACCESS_HOST=

# Optional: automate Gitea first-run setup. This is a one-time bootstrap helper
# for fresh Gitea data directories. Leave disabled if you prefer browser setup.
GITEA_BOOTSTRAP=0

# Required when GITEA_BOOTSTRAP=1.
# GITEA_ADMIN_EMAIL and GITEA_ADMIN_PASSWORD are consumed by bootstrap.sh and
# cleared from bootstrap/env after successful setup, so store them in your
# password manager if you need to keep a record.
GITEA_ADMIN_USERNAME=
GITEA_ADMIN_EMAIL=
GITEA_ADMIN_PASSWORD=

# Optional: add this public SSH key to the Gitea admin account.
# Relative paths are resolved from the repository root.
# Example: GITEA_ADMIN_SSH_PUBLIC_KEY_FILE=bootstrap/gitea-admin.pub
GITEA_ADMIN_SSH_PUBLIC_KEY_FILE=

# Optional: create an initial repository owned by the admin account.
GITEA_BOOTSTRAP_REPO=

# Optional: automate Jellyfin first-run setup. This is a one-time bootstrap
# helper for fresh Jellyfin data directories. Leave disabled for browser setup.
JELLYFIN_BOOTSTRAP=0

# Required when JELLYFIN_BOOTSTRAP=1.
# JELLYFIN_ADMIN_PASSWORD is consumed by bootstrap.sh and cleared from
# bootstrap/env after successful setup, so store it in your password manager.
JELLYFIN_ADMIN_USERNAME=
JELLYFIN_ADMIN_PASSWORD=

# Server and metadata defaults used by the startup wizard API.
JELLYFIN_SERVER_NAME=
JELLYFIN_UI_CULTURE=en-US
JELLYFIN_METADATA_LANGUAGE=en
JELLYFIN_METADATA_COUNTRY=US

# Optional: create initial media libraries.
JELLYFIN_CREATE_DEFAULT_LIBRARIES=1
JELLYFIN_MOVIES_LIBRARY_NAME=Movies
JELLYFIN_MOVIES_LIBRARY_PATH=/media/movies
JELLYFIN_TV_LIBRARY_NAME=TV
JELLYFIN_TV_LIBRARY_PATH=/media/tv
JELLYFIN_MUSIC_LIBRARY_NAME=Music
JELLYFIN_MUSIC_LIBRARY_PATH=/media/music

# Timezone used by containers and generated /srv/compose/.env.
TZ=America/Los_Angeles

# Where the runtime Compose bundle is installed on the server.
COMPOSE_TARGET_DIR=/srv/compose

# Set to 0 if you want bootstrap to install and lay out files without starting services.
START_SERVICES=1
